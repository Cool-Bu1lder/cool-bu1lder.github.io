---
import { type GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';

import LeftArrowIcon from '@assets/icons/arrow-left.svg';
import GitHubIcon from '@assets/icons/github.svg';
import ExternalLinkIcon from '@assets/icons/external-link.svg';

import Button from '@components/Button.astro';
import Callout from '@components/Callout.astro';
import Tabs from '@components/Tabs.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, technologies, year, demo, github, image, video } = project.data; // TODO: const { data } = project;
---

<BaseLayout title={title} description={description} image={image}>
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6 py-10 sm:py-14">
    <header>
      <video autoplay loop muted playsinline class="rounded-xl aspect-video w-full object-cover">
        <source src={`${base}/${video}`} type="video/mp4" />
        Your browser does not support the video tag.
      </video>

      <div class="flex flex-wrap items-center gap-3">
        <h1 class="mt-8 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      </div>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">{description}</p>

      <div class="mt-4 flex flex-wrap gap-1.5">
        {technologies.map((tech) => (
          <span class="rounded-md bg-muted px-2 py-1 font-mono text-xs text-muted-foreground">
            {tech}
          </span>
        ))}
        <span class="rounded-md bg-muted px-2 py-1 font-mono text-xs text-muted-foreground">
          {year}
        </span>
      </div>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {demo && (
          <Button href={demo} external size="sm">
            Live Demo
            <ExternalLinkIcon width={13} height={13} />
          </Button>
        )}
        {github && (
          <Button href={github} external variant="secondary" size="sm">
            <GitHubIcon width={13} height={13} />
            GitHub
          </Button>
        )}
      </div>
    </header>

    <div class="relative">
      <article class="prose mt-8 max-w-none" data-pagefind-body>
        <Content components={{ Callout, Tabs }} />
      </article>
    </div>

    <div class="mt-12 pt-6">
      <a
        href={`${base}/projects`}
        class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-accent"
      >
        <LeftArrowIcon width={13} height={13} />
        All projects
      </a>
    </div>
  </div>
</BaseLayout>
