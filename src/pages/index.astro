---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import CopyButton from '@components/CopyButton.astro';
import Section from '@components/Section.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ArticleCard from '@components/ArticleCard.astro';

import ProfileIcon from '@assets/profile.svg';
import OgIcon from '@assets/og.png';

import { FULL_NAME, ROLE, LOCATION, EMAIL } from '@utils/globals';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isProd = import.meta.env.PROD;

// TODO: get 3 recent posts
async function getPosts() {
  const posts = await getCollection('blog', ({ data }) => (isProd ? !data.draft : true));
  return posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
}

async function getProjects() {
  const projects = await getCollection('projects', ({ data }) => (isProd ? !data.draft : true));
  const featured = projects.filter((p) => p.data.featured !== undefined);
  return featured.sort((a, b) => a.data.featured! - b.data.featured!);
}

const posts = await getPosts();
const projects = await getProjects();

const title = `${FULL_NAME} - ${ROLE}`;
const description = 'Portfolio website featuring my projects and blogs.';
---

<BaseLayout title={title} description={description} image={OgIcon}>
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6">
    {/* ------------------------------ Hero ------------------------------ */}
    <section class="pt-14 sm:pt-20">
      <div class="flex flex-col items-center gap-5 text-center md:flex-row md:text-left md:justify-center">
        <ProfileIcon
          width="80"
          height="80"
          class="size-26 rounded-full border border-border bg-muted ring-2 ring-accent/25 ring-offset-2 ring-offset-background md:size-20"
        />
        <div class="min-w-0">
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-6xl">{FULL_NAME}</h1>
          <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-base text-muted-foreground">
            <span>{ROLE}</span>
            <span aria-hidden="true" class="opacity-50">
              ·
            </span>
            <span>{LOCATION}</span>
            <span aria-hidden="true" class="hidden opacity-50 sm:inline">
              ·
            </span>
            <span class="hidden items-center gap-0.5 sm:inline-flex">
              {EMAIL}
              <CopyButton text={EMAIL} label="Copy email address" />
            </span>
          </p>
        </div>
      </div>
    </section>

    {/* ---------------------- Featured projects ------------------------- */}
    <Section title="Featured projects" href={`${base}/projects`}>
      <div class="grid gap-x-4 gap-y-10 sm:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </Section>

    {/* ----------------------- Latest articles -------------------------- */}
    <Section title="Latest articles" href={`${base}/blog`}>
      <div class="flex flex-col gap-y-8">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </Section>
  </div>
</BaseLayout>
