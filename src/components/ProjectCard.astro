---
import { type CollectionEntry } from 'astro:content';

import GitHubIcon from '@assets/icons/github.svg';
import ExternalLinkIcon from '@assets/icons/external-link.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  project: CollectionEntry<'projects'>;
  showImage?: boolean;
}

const { project } = Astro.props;
const { data } = project;
const href = `${base}projects/${project.id}`;
const src = `${base}${data.video}`;

// TODO: use poster attribute on video tag for image thumbnail
---

<article class="group relative flex flex-col transition-all duration-300 ease-out rounded-xl hover:-m-3 hover:p-3 hover:bg-muted/60">
  <video loop muted playsinline class="rounded-xl aspect-video w-full object-cover bg-muted">
    <source src={src} type="video/mp4" />
    Your browser does not support the video tag.
  </video>

  <div class="flex flex-1 flex-col pt-2">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-semibold tracking-tight">
        <a
          href={href}
          class="after:absolute after:inset-0 transition-colors group-hover:text-accent"
        >
          {data.title}
        </a>
      </h3>
      {(data.developing && (
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[0.6875rem] font-medium bg-accent/15 text-accent">
          In progress
        </span>
      )) || <p class="ml-auto font-mono text-[0.6875rem] text-muted-foreground">{data.year}</p>}
    </div>

    <p class="mt-0 line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">
      {data.description}
    </p>

    <div class="mt-1 flex items-center justify-between gap-4">
      <div class="flex flex-wrap gap-1.5">
        {data.technologies.slice(0, 5).map((tech) => (
          <span class="rounded-md bg-muted px-2 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
            {tech}
          </span>
        ))}
      </div>

      <div class="flex items-center gap-1">
        {data.github && (
          <a
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${data.title} on GitHub`}
            class="z-10 size-5 inline-flex items-center justify-center rounded-md text-accent transition-colors hover:text-foreground"
          >
            <GitHubIcon width={14} height={14} />
          </a>
        )}
        {data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Live demo of ${data.title}`}
            class="z-10 size-5 inline-flex items-center justify-center rounded-md text-accent transition-colors hover:text-foreground"
          >
            <ExternalLinkIcon width={14} height={14} />
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll('article').forEach((article) => {
    const video = article.querySelector('video');

    if (article && video) {
      article.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });

      article.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    }
  });

  if (window.matchMedia('(max-width: 640px)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target.querySelector('video');
          if (!video) return;

          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
            video.currentTime = 0;
          }
        });
      },
      {
        threshold: 0.8,
        rootMargin: '-15% 0px -15% 0px',
      },
    );

    document.querySelectorAll('article').forEach((article) => observer.observe(article));
  }
</script>
