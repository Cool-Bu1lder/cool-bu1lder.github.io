---
import ProfileIcon from '@assets/profile.svg';
import MenuIcon from '@assets/icons/menu.svg';
import CloseIcon from '@assets/icons/x.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// TODO: use a nav link component?
function isActive(href: string): boolean {
  const cleanHref = href.replace(/\/$/, '') || '/';
  return pathname === cleanHref;
}

import { SITE_NAME, NAV_LINKS, SOCIAL_LINKS } from '@utils/globals';
---

<header class="fixed top-0 w-full z-40 bg-background/80 backdrop-blur-md">
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6">
    <div class="flex h-14 items-center justify-between gap-4">
      <div class="flex items-center gap-6">
        <a
          href={`${base}/`}
          class="shrink-0 flex items-center gap-2 text-lg font-bold tracking-tight whitespace-nowrap text-foreground"
        >
          <span class="flex size-6 items-center justify-center rounded-md bg-primary text-primary-foreground">
            <ProfileIcon width={32} height={32} />
          </span>
          {SITE_NAME}
        </a>

        <div class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
          {NAV_LINKS.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-1.5 text-sm transition-colors',
                isActive(item.href)
                  ? 'font-medium text-foreground'
                  : 'text-muted-foreground hover:bg-muted hover:text-foreground',
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex items-center gap-1.5">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={link.name}
            class="hidden size-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:inline-flex"
          >
            <link.icon width={17} height={17} />
          </a>
        ))}
      </div>

      <div class="-mr-2 flex md:hidden">
        <button
          type="button"
          id="mobile-nav-toggle"
          class="inline-flex size-9 items-center justify-center rounded-lg text-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden cursor-pointer"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
        >
          <MenuIcon width={24} height={24} class="menu-icon" />
          <CloseIcon width={24} height={24} class="close-icon hidden" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    hidden
    class="inset-x-0 top-14 z-30 md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0"
  >
    <nav
      class="mx-auto w-full max-w-3xl px-5 sm:px-6 flex flex-col gap-1 p-4"
      aria-label="Mobile navigation"
    >
      {NAV_LINKS.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-2.5 text-sm text-foreground ',
            isActive(item.href) && 'font-bold bg-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={link.name}
          class="inline-flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-foreground"
        >
          <link.icon width={16} height={16} /> {link.name}
        </a>
      ))}
    </nav>
  </div>
</header>

<div class="pb-14" />

<script>
  function initMobileNav() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    if (!toggle || !panel) return;

    const menuIcon = toggle.querySelector('.menu-icon');
    const closeIcon = toggle.querySelector('.close-icon');

    function setOpen(open: boolean) {
      panel!.hidden = !open;
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      menuIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);

      if (!open) {
        panel!.style.maxHeight = '0px';
      } else {
        panel!.style.maxHeight = panel!.scrollHeight + 'px';
      }
    }

    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    // Close when a link is chosen
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
  initMobileNav();
</script>
